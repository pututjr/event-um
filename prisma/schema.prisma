generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  PESERTA
}

enum JenisPeserta {
  MAHASISWA
  DOSEN
  TENDIK
  UMUM
}

enum StatusKegiatan {
  AKTIF
  SELESAI
  DIBATALKAN
}

enum StatusPendaftaran {
  TERDAFTAR
  HADIR
  SERTIFIKAT_TERBIT
}

enum StatusSertifikat {
  PENDING
  GENERATED
  FAILED
}

// id is NOT auto-generated - it must equal the Supabase Auth user's id
// (auth.users.id) so profile/role data here stays linked to the Supabase
// Auth account that owns login/password.
model User {
  id        String   @id
  email     String   @unique
  role      Role     @default(PESERTA)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  peserta   Peserta?
}

model Peserta {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  namaLengkap  String
  noHp         String?
  instansi     String?
  unitProdi    String?
  jenisPeserta JenisPeserta  @default(UMUM)
  gelar        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  pendaftaran  Pendaftaran[]
}

model Kegiatan {
  id             String         @id @default(cuid())
  judul          String
  deskripsi      String?
  lokasi         String?
  tanggalMulai   DateTime
  tanggalSelesai DateTime
  kuota          Int?
  status         StatusKegiatan @default(AKTIF)
  narasumber     String?
  jabatanNarasumber String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  pendaftaran    Pendaftaran[]
}

model Pendaftaran {
  id            String            @id @default(cuid())
  pesertaId     String
  peserta       Peserta           @relation(fields: [pesertaId], references: [id], onDelete: Cascade)
  kegiatanId    String
  kegiatan      Kegiatan          @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)
  status        StatusPendaftaran @default(TERDAFTAR)
  tanggalDaftar DateTime          @default(now())
  tanggalHadir  DateTime?
  catatan       String?
  sertifikat    Sertifikat?

  @@unique([pesertaId, kegiatanId])
}

// The .docx file itself lives in Google Drive - only metadata is kept here
// (Google Drive is the source of truth for files, Postgres/Supabase for
// application data).
model SertifikatTemplate {
  id            String       @id @default(cuid())
  nama          String
  jumlahHalaman Int          @default(1)
  fileName      String
  mimeType      String
  driveFileId   String
  driveUrl      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sertifikat    Sertifikat[]
}

model Sertifikat {
  id               String             @id @default(cuid())
  pendaftaranId    String             @unique
  pendaftaran      Pendaftaran        @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)
  templateId       String
  template         SertifikatTemplate @relation(fields: [templateId], references: [id])
  nomorSertifikat  String             @unique
  status           StatusSertifikat   @default(PENDING)
  driveFileId      String?
  driveUrl         String?
  driveFolder      String?
  errorMessage     String?
  generatedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}
